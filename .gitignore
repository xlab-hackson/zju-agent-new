# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
out/
*.tsbuildinfo

# Vite
*.local

# Environment
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# OS
.DS_Store
Thumbs.db

# Local data (本地优先应用运行时数据，绝不入库)
data/
# Flutter's data layer is source code, not runtime data.
!/apps/flutter/lib/data/
!/apps/flutter/lib/data/*.dart
*.db
*.sqlite
*.sqlite-journal
downloads/
# Download UI components are source code, not downloaded runtime files.
!/apps/flutter/lib/ui/downloads/
!/apps/flutter/lib/ui/downloads/*.dart

# TypeScript
*.tsbuildinfo

# Dev server runtime (started by AI helper)
.run/

# Local Flutter toolchain and generated caches
.tooling/
.dart_tool/
.flutter-plugins-dependencies
**/android/local.properties
**/android/.gradle/
**/windows/flutter/ephemeral/
foragent/
