{
  "name": "zju-campus-agent",
  "version": "0.1.0",
  "private": true,
  "description": "浙江大学校园智能 Agent — 本地优先的校园智能助手",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter=./apps/* --filter=./packages/* run dev",
    "dev:web": "pnpm --filter @zju-agent/web dev",
    "dev:server": "pnpm --filter @zju-agent/server dev",
    "build": "pnpm -r run build",
    "build:web": "pnpm --filter @zju-agent/web build",
    "build:server": "pnpm --filter @zju-agent/server build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "pnpm -r exec rm -rf dist build .tsbuildinfo node_modules"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^2.1.9"
  }
}
