{
  "name": "@zju-agent/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "ZJU Campus Agent — 浙江大学校园智能助手桌面应用",
  "author": "ZJU Agent Team",
  "homepage": "https://github.com/zju-agent/zju-agent",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "icons": "node scripts/make-icon.mjs",
    "build:main": "node scripts/build-main.js",
    "build:server": "node scripts/build-server.js",
    "build:web": "pnpm --filter @zju-agent/web build && node scripts/copy-web.js",
    "build": "npm run build:main && npm run build:server && npm run build:web",
    "pack": "npm run build && electron-builder --config electron-builder.yml",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "typescript": "^5.9.3"
  }
}
